      },
      {
        "npc": { "hy": "Ես Անին եմ։ Որտեղի՞ց ես։", "tr": "yes Anin em. vorteghits' es", "it": "Sono Ani. Di dove sei?" },
        "prompt": "Rispondi da dove vieni.",
