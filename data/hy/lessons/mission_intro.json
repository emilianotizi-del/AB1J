          { "hy": "Ես լավ եմ։", "it": "Sto bene.", "ok": false },
          { "hy": "Ժամը հինգն է։", "it": "Sono le cinque.", "ok": false }
        ]
      },
      {
        "npc": { "hy": "Իսկ ի՞նչ ես անում այստեղ։", "tr": "isk inch es anum aystegh", "it": "E cosa fai qui?" },
        "prompt": "Di' che stai imparando l'armeno.",
        "options": [
          { "hy": "Հայերեն եմ սովորում։", "it": "Sto imparando l'armeno.", "ok": true,
            "reply": { "hy": "Ապրե՛ս։ Շատ լավ ես խոսում։", "it": "Bravo! Parli molto bene." } },
          { "hy": "Ջուր եմ ուզում։", "it": "Voglio dell'acqua.", "ok": false },
