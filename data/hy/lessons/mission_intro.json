        { "hy": "Իսկ դու՞", "tr": "isk du", "it": "E tu?" },
        { "hy": "Ուրախ եմ", "tr": "urakh em", "it": "Piacere (sono lieto)" },
        { "hy": "Որտեղի՞ց ես", "tr": "vorteghits' es", "it": "Di dove sei?" }
      ]
